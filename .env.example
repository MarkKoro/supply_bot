TG_TOKEN=your_telegram_bot_token
APP_TZ=UTC
# All processes must share this path. Prefer an absolute path in production.
DB_PATH=data/supply_bot.sqlite3
AUTO_SEED_ON_START=1
SEED_SUPPLEMENTS_PATH=data/seed_rich/supplements_rich.jsonl
# Optional separate file; embedded interactions are already in the rich seed.
SEED_INTERACTIONS_PATH=

# Telegram numeric IDs. OWNER_TG_ID controls role management.
ADMIN_IDS=
ADMIN_TG_IDS=
OWNER_TG_ID=0
BOT_USERNAME=
DEBUG=0

# Public HTTPS deployment. Match these paths with the reverse proxy.
WEBAPP_URL=
PUBLIC_BASE_URL=
PROJECT_KEY=supply_bot
WEBAPP_PUBLIC_PATH=/supply

# Existing model defaults, unchanged by the audit.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_NUTRIENT_ASSISTANT_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_STT_MODEL=
AI_MAX_PER_DAY=1

# Blank RUB flag enables RUB only with shop ID and secret present.
YOOKASSA_PROVIDER_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_WIDGET_ENABLED=0
BILLING_ENABLED_RUB=
BILLING_ENABLED_STARS=1
PAYMENTS_EXTERNAL_ONLY=0
# Months; RUB prices are kopecks, Stars prices are whole Stars.
PREMIUM_PLANS={"m1":1,"m3":3,"m6":6,"m12":12}
PREMIUM_PRICES_RUB={"m1":20000,"m3":54000,"m6":96000,"m12":168000}
PREMIUM_PRICES_STARS={"m1":250,"m3":650,"m6":1200,"m12":2000}

# Existing legal document defaults.
OFFER_VERSION=2026-03-08
PRIVACY_VERSION=2026-03-08
OFFER_URL=https://telegra.ph/Oferta-03-08-3
PRIVACY_URL=https://telegra.ph/Popd-03-08
